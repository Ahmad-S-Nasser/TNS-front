{
  "Keycloak": {
    "realm": "tips-steps",
    "auth-server-url": "http://keycloak:8080/",
    "ssl-required": "none",
    "resource": "tns-gateway",
    "verify-token-audience": true,
    "credentials": {
      "secret": "change-me-in-production"
    },
    "use-resource-role-mappings": true,
    "confidential-port": 0
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "https://steps-caretaker-hub.lovable.app"
    ]
  },
  "Seq": {
    "Url": "http://seq:80"
  },
  "ReverseProxy": {
    "Routes": {
      "mobile-usermgmt": {
        "ClusterId": "usermgmt-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/mobile/users/{**catch-all}" }
      },
      "mobile-content": {
        "ClusterId": "content-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/mobile/content/{**catch-all}" }
      },
      "mobile-growth": {
        "ClusterId": "growth-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/mobile/growth/{**catch-all}" }
      },
      "mobile-notifications": {
        "ClusterId": "notification-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/mobile/notifications/{**catch-all}" }
      },
      "mobile-qa": {
        "ClusterId": "qa-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/mobile/qa/{**catch-all}" }
      },
      "mobile-health-intel": {
        "ClusterId": "healthintel-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/mobile/health-intel/{**catch-all}" }
      },
      "admin-usermgmt": {
        "ClusterId": "usermgmt-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/admin/users/{**catch-all}" }
      },
      "admin-content": {
        "ClusterId": "content-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/admin/content/{**catch-all}" }
      },
      "admin-analytics": {
        "ClusterId": "analytics-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/admin/analytics/{**catch-all}" }
      },
      "admin-growth": {
        "ClusterId": "growth-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/admin/growth/{**catch-all}" }
      },
      "admin-qa": {
        "ClusterId": "qa-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/admin/qa/{**catch-all}" }
      },
      "admin-health-intel": {
        "ClusterId": "healthintel-cluster",
        "AuthorizationPolicy": "Default",
        "Match": { "Path": "/admin/health-intel/{**catch-all}" }
      }
    },
    "Clusters": {
      "usermgmt-cluster": {
        "Destinations": {
          "usermgmt-svc": { "Address": "http://usermgmt-svc:8080" }
        }
      },
      "content-cluster": {
        "Destinations": {
          "content-svc": { "Address": "http://content-svc:8080" }
        }
      },
      "growth-cluster": {
        "Destinations": {
          "growth-svc": { "Address": "http://growth-svc:8080" }
        }
      },
      "notification-cluster": {
        "Destinations": {
          "notification-svc": { "Address": "http://notification-svc:8080" }
        }
      },
      "qa-cluster": {
        "Destinations": {
          "qa-svc": { "Address": "http://qa-svc:8080" }
        }
      },
      "analytics-cluster": {
        "Destinations": {
          "analytics-svc": { "Address": "http://analytics-svc:8080" }
        }
      },
      "healthintel-cluster": {
        "Destinations": {
          "healthintel-svc": { "Address": "http://healthintel-svc:8080" }
        }
      }
    }
  }
}
